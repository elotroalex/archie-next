---
layout: default
lang: en
pagination:
  data: issues
  size: 1
  alias: issueKey
  resolve: keys
  # true so every issue TOC page reaches collections.all, which
  # src/sitemap.11ty.js builds from. With false only the first paginated
  # page was collected, leaving issue02-09 out of the sitemap.
  addAllPagesToCollections: true
eleventyComputed:
  title: "{{ i18n[lang].issues[issueKey] }}"
  permalink: "{{ issueKey }}.html"
---

<h1 class="journal-title">{{ site.title }}</h1>
<h2>{{ i18n[lang].issues[issueKey] }}</h2>

{% set issueTag = issueKey %}
{% include "toc.njk" %}

<hr>

{% set currentIssueKey = issueKey %} {% include "issues-list.njk" %}
