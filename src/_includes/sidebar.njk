<input type="checkbox" class="sidebar-checkbox" id="sidebar-checkbox" />

<aside class="sidebar" id="sidebar">
  <div class="sidebar-item">
    {% if layout != "article" %}
    <p><em>archipelagos</em>—{{ i18n[lang].global.subtitle }}.</p>
    {% else %}
    <p class="article-title">
      {{ title.long | mdInline | safe if title.long else title }}
    </p>
    <p>{% include "author-loop.njk" %}</p>
    <p>Issue ({{ issue }}) | {{ pubDate }}<br />DOI: {{ doi }}</p>
    {% endif %}
  </div>
  {# Every info/CFP page has a real per-language variant at /{lang}/page.html
     (e.g. src/_i18n/es/about.md's own front matter sets permalink: es/about.html) --
     these links previously pointed at the English URL unconditionally on
     every page regardless of `lang`, sending e.g. a reader on /es/about.html
     to /about.html via the sidebar's own "about us" link. #}
  {% set langPrefix = "" if lang == "en" else lang + "/" %}
  <nav class="main-nav" aria-label="{{ i18n[lang].global.main_nav_label }}">
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'index.html') | url }}">{{ i18n[lang].titles.home }}</a>
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'index.html') | url }}#issues-list-heading">{{ i18n[lang].global.issues_label }}</a>
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'about.html') | url }}">{{ i18n[lang].titles.about }}</a>
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'credits.html') | url }}">{{ i18n[lang].titles.credits }}</a>
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'authors.html') | url }}">{{ i18n[lang].titles.authors }}</a>
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'reviewers.html') | url }}">{{ i18n[lang].titles.reviewers }}</a>
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'workflow.html') | url }}">{{ i18n[lang].titles.workflow }}</a>
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'valences.html') | url }}">{{ i18n[lang].titles.valences }}</a>
    <a class="sidebar-nav-item" href="{{ ('/' + langPrefix + 'cfp/open.html') | url }}">{{ i18n[lang].titles.cfp }}</a>
  </nav>

  <div class="sidebar-footer">
    {% if layout != "article" %}
    <p>&copy; 2025. Archipelagos.</p>
    {% else %}
    <p>&copy; 2025. {% include "author-loop.njk" %}.</p>
    {% endif %}
    <p>{{ i18n[lang].components.ccby | safe }} <a href="{{ site.githuburl }}">{{ i18n[lang].components.repository }}</a>.</p>
    <p>ISSN: {{ site.issn }}</p>
  </div>
</aside>
