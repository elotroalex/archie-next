# Copy to utility/deploy.env (gitignored) and fill in.
# The real values live in the private ops notes, not in this public repository.
#
# Used by utility/traffic-report.sh, and handy to source before a manual deploy.

DEPLOY_HOST=server.example.reclaimhosting.com
DEPLOY_USER=youraccount
DEPLOY_KEY=$HOME/.ssh/your_deploy_key

# Docroots
DEPLOY_PATH=/home/youraccount/public_html/
PREVIEW_PATH=/home/youraccount/preview.example.org/

# Public site domain -- only used to filter self-referrals out of the
# referrer list in traffic-report.sh.
SITE_DOMAIN=example.org
